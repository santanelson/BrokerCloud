# Configurações do Banco de Dados
DB_USER=brokercloud
DB_PASS=suasenhaforte
DB_NAME=brokercloud

# Portas publicadas na VPS
# Se ja existir Postgres/Redis/Node na VPS, troque aqui antes do deploy.
WEB_PORT=3000
API_PORT=3001
DB_PORT=5432
REDIS_PORT=6379

# URLs do Frontend no momento do build (Next.js exige elas no build)
# Substitua pelos domínios da VPS (ex: https://api.selectahome.com.br)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui
