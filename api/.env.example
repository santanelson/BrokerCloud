# BrokerCloud API — Environment Variables
# Copie este arquivo para .env e preencha os valores

# ─── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://brokercloud:brokercloud_dev_pass@localhost:5432/brokercloud"

# ─── Auth (JWT) ────────────────────────────────────────────────────
JWT_SECRET="mude_para_um_segredo_forte_de_pelo_menos_64_caracteres_aqui"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="outro_segredo_forte_para_refresh_tokens_aqui"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Cloudflare R2 ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="brokercloud"
R2_PUBLIC_URL="https://seu-dominio.r2.dev"

# ─── Evolution Go API ──────────────────────────────────────────────
EVOLUTION_API_URL="https://sua-instancia-evolution.com"
EVOLUTION_API_KEY=""

# ─── Frontend ──────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
